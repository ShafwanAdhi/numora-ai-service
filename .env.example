# PostgreSQL diakses langsung oleh backend Python service AI.
# Isi DATABASE_URL di .env lokal; jangan memasukkan kredensial ke browser/Git.
# Format:
# postgresql://NUMORA_AI_USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Hak akses mengikuti akun DB yang kamu isi; tidak memaksakan role/view tertentu.
# Karakter khusus pada user/password harus di-URL-encode.
DATABASE_URL=
