# Merge these variables into the existing .env or a server-only EnvironmentFile.
# Default disabled; never share this token with frontend clients.
NUMORA_GENERATOR_ENABLED=false
NUMORA_GENERATOR_V2_ENABLED=false
# Windows default retained; Linux container sets its explicitly reviewed profile.
# NUMORA_RENDERER_PROFILE=linux-amd64-bookworm-cpython-3.11.14-pillow-12.1.0-v1
NUMORA_GENERATOR_TOKEN=
COMPUTE_DATABASE_URL=
COMPUTE_SERVICE_PRINCIPAL_ID=
# Separate non-owner compute LOGIN with numora_irt_runtime only.
# Remote URL: sslmode=verify-full plus trusted sslrootcert; DATABASE_URL remains
# the legacy read-only browser credential and is never used for compute writes.
