    },
    {
      "id": "B",
      "text": "Persamaan x^2+3x=10 merupakan PLSV karena hanya mengandung satu jenis variabel, yaitu x.",
      "correct": false
    },
    {
      "id": "C",
      "text": "Persamaan (1)/(3)y+{v4}={v5} ekuivalen dengan persamaan y+{v6}={v7}.",
      "correct": true
    },
    {
      "id": "D",
      "text": "Persamaan 3a+2b=12 merupakan bentuk PLSV karena variabelnya berpangkat satu.",
      "correct": false
    }
  ],
  "explanation": "A menyederhana menjadi 2x={v8}, x={v9}. C dikalikan tiga menjadi y+{v10}={v11}. B kuadrat, D dua variabel."
