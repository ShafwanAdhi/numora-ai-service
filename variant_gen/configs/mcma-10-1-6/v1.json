  "constraints": [],
  "stem": "Siswa kelas VIII melakukan latihan memfaktorkan dan menjabarkan berbagai bentuk aljabar di papan tulis. Manakah di antara pernyataan penjabaran dan pemfaktoran berikut yang BENAR? (Jawaban boleh lebih dari satu)",
  "options": [
    {
      "id": "A",
      "text": "Penjabaran dari (2x-{v1})^2 adalah 4x^2-{v2}x+{v3}.",
      "correct": true
    },
    {
      "id": "B",
      "text": "Pemfaktoran dari x^2-{v4} adalah (x-{v5})(x+{v6}).",
      "correct": true
    },
    {
      "id": "C",
      "text": "Pemfaktoran dari x^2-{v7}x+{v8} adalah (x-{v9})(x-{v10}).",
      "correct": true
    },
    {
      "id": "D",
      "text": "Penjabaran dari (3x+{v11})(x-{v12}) adalah 3x^2-{v13}x-{v14}.",
      "correct": false
    }
  ],
  "explanation": "Kuadrat A: 4x^2-{v15}x+{v16}. B selisih kuadrat dengan akar +/-{v17}. C faktor akar {v18} dan {v19}. D seharusnya 3x^2-{v20}x-{v21}, bukan koefisien x {v22}."
}
