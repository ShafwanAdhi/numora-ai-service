  "stem": "Siswa kelas VIII melakukan latihan memfaktorkan dan menjabarkan berbagai bentuk aljabar di papan tulis. Manakah di antara pernyataan penjabaran dan pemfaktoran berikut yang BENAR? (Jawaban boleh lebih dari satu)",
  "options": [
    {
      "id": "A",
      "text": "Penjabaran dari (3x-{v1})^2 adalah 9x^2-{v2}x+{v3}.",
      "correct": true
    },
    {
      "id": "B",
      "text": "Pemfaktoran dari 4x^2-{v4} adalah (2x-{v5})(2x+{v6}).",
      "correct": true
    },
    {
      "id": "C",
      "text": "Pemfaktoran dari x^2+{v7}x-{v8} adalah (x+{v9})(x-{v10}).",
      "correct": true
    },
    {
      "id": "D",
      "text": "Penjabaran dari (2x+{v11})(x-{v12}) adalah 2x^2-{v13}x-{v14}.",
      "correct": false
    }
  ],
  "explanation": "A kuadrat sempurna; B selisih kuadrat; C faktor (x+{v15})(x-{v16}). D yang benar 2x^2-{v17}x-{v18}, bukan koefisien x {v19}."
