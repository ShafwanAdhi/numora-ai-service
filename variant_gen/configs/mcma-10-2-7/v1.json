  "constraints": [],
  "stem": "Tim proyek Green School mencatat produksi pupuk kompos dari dua kelompok siswa:\nKelompok A: A=2(3x^2-4x+{v1})\nKelompok B: B=3(x^2+2x-{v2})\nManakah pernyataan analisis berikut yang BENAR terkait hubungan kedua bentuk aljabar tersebut? (Jawaban boleh lebih dari satu)",
  "options": [
    {
      "id": "A",
      "text": "Bentuk sederhana dari A+B adalah 9x^2-2x+{v3}.",
      "correct": true
    },
    {
      "id": "B",
      "text": "Bentuk sederhana dari A-B adalah 3x^2-14x+{v4}.",
      "correct": true
    },
    {
      "id": "C",
      "text": "Koefisien dari variabel x pada bentuk A+B adalah -2.",
      "correct": true
    },
    {
      "id": "D",
      "text": "Nilai konstanta dari bentuk A-B adalah {v5}.",
      "correct": false
    }
  ],
  "explanation": "A=6x^2-8x+{v6}, B=3x^2+6x-{v7}. Jumlah 9x^2-2x+{v8}; selisih 3x^2-14x+{v9}. Konstanta selisih {v10}, bukan {v11}."
